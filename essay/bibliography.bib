@online{devlinBERTPretrainingDeep2019a,
  title = {{{BERT}}: {{Pre-training}} of {{Deep Bidirectional Transformers}} for {{Language Understanding}}},
  shorttitle = {{{BERT}}},
  author = {Devlin, Jacob and Chang, Ming-Wei and Lee, Kenton and Toutanova, Kristina},
  date = {2019-05-24},
  eprint = {1810.04805},
  eprinttype = {arXiv},
  eprintclass = {cs},
  doi = {10.48550/arXiv.1810.04805},
  url = {http://arxiv.org/abs/1810.04805},
  urldate = {2026-03-24},
  abstract = {We introduce a new language representation model called BERT, which stands for Bidirectional Encoder Representations from Transformers. Unlike recent language representation models, BERT is designed to pre-train deep bidirectional representations from unlabeled text by jointly conditioning on both left and right context in all layers. As a result, the pre-trained BERT model can be fine-tuned with just one additional output layer to create state-of-the-art models for a wide range of tasks, such as question answering and language inference, without substantial task-specific architecture modifications. BERT is conceptually simple and empirically powerful. It obtains new state-of-the-art results on eleven natural language processing tasks, including pushing the GLUE score to 80.5\% (7.7\% point absolute improvement), MultiNLI accuracy to 86.7\% (4.6\% absolute improvement), SQuAD v1.1 question answering Test F1 to 93.2 (1.5 point absolute improvement) and SQuAD v2.0 Test F1 to 83.1 (5.1 point absolute improvement).},
  pubstate = {prepublished},
  keywords = {Computer Science - Computation and Language},
  file = {C\:\\Users\\Charlie\\Zotero\\storage\\HKUWZVHA\\Devlin et al. - 2019 - BERT Pre-training of Deep Bidirectional Transformers for Language Understanding.pdf;C\:\\Users\\Charlie\\Zotero\\storage\\3KYLBK8R\\1810.html}
}

@article{direstaFullSpectrumPropagandaSocial2025,
  title = {Full-{{Spectrum Propaganda}} in the {{Social Media Era}}},
  author = {DiResta, Renée and Goldstein, Josh A.},
  date = {2025-08-08},
  journaltitle = {Security Studies},
  volume = {34},
  number = {4},
  pages = {714--750},
  publisher = {Routledge},
  issn = {0963-6412},
  doi = {10.1080/09636412.2025.2563254},
  url = {https://doi.org/10.1080/09636412.2025.2563254},
  urldate = {2026-04-07},
  abstract = {How do states wage propaganda campaigns in the social media era? Existing studies often investigate either covert fake accounts on social media platforms or overt propaganda on traditional broadcast media. We argue that states now wage integrated campaigns, using multiple media channels that cite each other directly, or parallel campaigns, using multiple channels concurrently but independently of one another. We refer to these as “full-spectrum propaganda campaigns.” To advance the literature on state-backed propaganda, we categorize media channels along two dimensions: whether they are overt or covert, and whether broadcast or social. We use this framework, alongside evidence from leaked documents, to highlight the strengths and weaknesses of different channels and evaluate why states may choose one over another. We then show how states use multiple channels together in full-spectrum propaganda campaigns through illustrative case studies of the Chinese Communist Party and RIA FAN (Russian Federal News Agency).},
  file = {C:\Users\Charlie\Zotero\storage\FWX8SJ2D\DiResta and Goldstein - 2025 - Full-Spectrum Propaganda in the Social Media Era.pdf}
}

